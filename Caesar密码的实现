#include <stdio.h>

#include <string.h>

#include <ctype.h>



 

void caesar_cipher(char* output, const char* input, int shift) {

    shift = (shift % 26 + 26) % 26; 

    for (int i = 0; input[i] != '\0'; ++i) {

        char ch = input[i];

        if (islower(ch)) {

            output[i] = 'a' + (ch - 'a' + shift) % 26;

        }

        else if (isupper(ch)) {

            output[i] = 'A' + (ch - 'A' + shift) % 26;

        }

        else {

            output[i] = ch; 

        }

    }

    output[strlen(input)] = '\0';

}



int main() {

    int choice = 0;

    char input[1024] = {0};

    char output[1024] = {0};

    int key = 0;



    do {

        printf("\nCaesar密码系统\n");

        printf("--------------------------------\n");

        printf("1. 加密\n2. 解密\n3. 退出\n");

        printf("请选择操作：");



        

        char choice_input[10];

        if (fgets(choice_input, sizeof(choice_input), stdin) == NULL || sscanf_s(choice_input, "%d", &choice) != 1) {

            printf("无效输入，请输入数字！\n");

            continue;

        }



        if (choice == 1 || choice == 2) {

            printf("请输入%s（最多1023字符）：", (choice == 1) ? "明文" : "密文");

            if (fgets(input, sizeof(input), stdin) == NULL) {

                printf("输入错误，请重试！\n");

                continue;

            }



            input[strcspn(input, "\n")] = '\0';



            printf("请输入密钥：");

            char key_input[10];

            if (fgets(key_input, sizeof(key_input), stdin) == NULL || sscanf_s(key_input, "%d", &key) != 1) {

                printf("无效密钥，请输入数字！\n");

                continue;

            }



            int shift = (choice == 1) ? key : -key;

            caesar_cipher(output, input, shift);



            printf("%s结果：%s\n", (choice == 1) ? "加密" : "解密", output);

            printf("--------------------------------\n");

        }

        else if (choice != 3) {

            printf("无效输入，请重新选择！\n");

        }

    } while (choice != 3);



    printf("程序已退出。\n");

    return 0;

}

